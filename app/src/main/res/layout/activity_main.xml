<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_black">

    <!-- Barra Superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnTrash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/trash_title"
            app:srcCompat="@drawable/ic_trash" />
    </LinearLayout>

    <!-- Banner aviso de Shizuku apagado -->
    <TextView
        android:id="@+id/bannerShizuku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/accent_red"
        android:padding="10dp"
        android:text="@string/shizuku_not_running"
        android:textColor="@color/text_white"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Barra de Búsqueda -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="@color/surface_card"
        android:hint="@string/search_hint"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp"
        android:singleLine="true" />

    <!-- Filtro Segmentado: Todas | Sistema | Usuario -->
    <RadioGroup
        android:id="@+id/rgFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="8dp"
        android:checkedButton="@+id/rbAll"
        android:gravity="center"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_all"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbSystem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_system"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_user"
            android:textColor="@color/text_white"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- Lista de Apps -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
